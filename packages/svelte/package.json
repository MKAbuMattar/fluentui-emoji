{
  "name": "@fluentui-emoji/svelte",
  "version": "2.0.0-beta.0",
  "description": "Fluent UI Emoji for Svelte 5 — tree-shakeable icon data plus a single Emoji component (flat, high-contrast, modern).",
  "keywords": [
    "fluentui",
    "emoji",
    "fluentui-emoji",
    "icons",
    "svg",
    "svelte"
  ],
  "license": "MIT",
  "author": {
    "name": "Mohammad Abu Mattar",
    "email": "mohammad.khaled@outlook.com",
    "url": "https://mkabumattar.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MKAbuMattar/fluentui-emoji.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/MKAbuMattar/fluentui-emoji/issues"
  },
  "homepage": "https://fluentui-emoji.mkabumattar.com/",
  "type": "module",
  "sideEffects": false,
  "svelte": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "svelte": "./src/index.js",
      "default": "./src/index.js"
    },
    "./flat": {
      "types": "./dist/flat/index.d.ts",
      "default": "./dist/flat/index.js"
    },
    "./flat/*": {
      "types": "./dist/flat/icons/*.d.ts",
      "default": "./dist/flat/icons/*.js"
    },
    "./high-contrast": {
      "types": "./dist/high-contrast/index.d.ts",
      "default": "./dist/high-contrast/index.js"
    },
    "./high-contrast/*": {
      "types": "./dist/high-contrast/icons/*.d.ts",
      "default": "./dist/high-contrast/icons/*.js"
    },
    "./modern": {
      "types": "./dist/modern/index.d.ts",
      "default": "./dist/modern/index.js"
    },
    "./modern/*": {
      "types": "./dist/modern/icons/*.d.ts",
      "default": "./dist/modern/icons/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsx build.ts",
    "test": "tsx test/smoke.ts"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "svelte": "^5.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  }
}
