{
  "name": "@fluentui-emoji/react-native",
  "version": "2.1.0",
  "description": "Fluent UI Emoji as typed React Native components built on react-native-svg (flat, high-contrast, modern).",
  "keywords": [
    "fluentui",
    "emoji",
    "fluentui-emoji",
    "icons",
    "svg",
    "react-native"
  ],
  "license": "MIT",
  "author": {
    "name": "Mohammad Abu Mattar",
    "email": "mohammad.khaled@outlook.com",
    "url": "https://mkabumattar.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MKAbuMattar/fluentui-emoji.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/MKAbuMattar/fluentui-emoji/issues"
  },
  "homepage": "https://fluentui-emoji.mkabumattar.com/",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "module": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./flat": {
      "types": "./dist/flat/index.d.ts",
      "default": "./dist/flat/index.js"
    },
    "./flat/*": {
      "types": "./dist/flat/icons/*.d.ts",
      "default": "./dist/flat/icons/*.js"
    },
    "./high-contrast": {
      "types": "./dist/high-contrast/index.d.ts",
      "default": "./dist/high-contrast/index.js"
    },
    "./high-contrast/*": {
      "types": "./dist/high-contrast/icons/*.d.ts",
      "default": "./dist/high-contrast/icons/*.js"
    },
    "./modern": {
      "types": "./dist/modern/index.d.ts",
      "default": "./dist/modern/index.js"
    },
    "./modern/*": {
      "types": "./dist/modern/icons/*.d.ts",
      "default": "./dist/modern/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/core.ts --format esm --dts --out-dir dist --external react --external react-native-svg && tsx build.ts",
    "test": "tsx test/smoke.ts"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-native-svg": ">=13"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.2.9",
    "react": "^19.2.4",
    "react-native-svg": "^15.15.5",
    "tsup": "^8.5.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  }
}
