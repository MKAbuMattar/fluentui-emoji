{
  "name": "@fluentui-emoji/sprite",
  "version": "2.0.0",
  "description": "Fluent UI Emoji as SVG symbol sprites — one <use href> sheet per set, ideal for pages showing many emojis.",
  "keywords": [
    "fluentui",
    "emoji",
    "fluentui-emoji",
    "icons",
    "svg",
    "sprite",
    "symbol"
  ],
  "license": "MIT",
  "author": {
    "name": "Mohammad Abu Mattar",
    "email": "mohammad.khaled@outlook.com",
    "url": "https://mkabumattar.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MKAbuMattar/fluentui-emoji.git",
    "directory": "packages/sprite"
  },
  "bugs": {
    "url": "https://github.com/MKAbuMattar/fluentui-emoji/issues"
  },
  "homepage": "https://fluentui-emoji.mkabumattar.com/",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./flat.svg": "./dist/flat.svg",
    "./high-contrast.svg": "./dist/high-contrast.svg",
    "./modern.svg": "./dist/modern.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --out-dir dist && tsx build.ts",
    "test": "tsx test/smoke.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  }
}
