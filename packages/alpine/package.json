{
  "name": "@fluentui-emoji/alpine",
  "version": "2.1.0",
  "description": "Fluent UI Emoji as an Alpine.js plugin — x-fluent-emoji directive and $fluentEmoji magic with tree-shakeable icon data (flat, high-contrast, modern).",
  "keywords": [
    "fluentui",
    "emoji",
    "fluentui-emoji",
    "icons",
    "svg",
    "alpine",
    "alpinejs"
  ],
  "license": "MIT",
  "author": {
    "name": "Mohammad Abu Mattar",
    "email": "mohammad.khaled@outlook.com",
    "url": "https://mkabumattar.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MKAbuMattar/fluentui-emoji.git",
    "directory": "packages/alpine"
  },
  "bugs": {
    "url": "https://github.com/MKAbuMattar/fluentui-emoji/issues"
  },
  "homepage": "https://fluentui-emoji.mkabumattar.com/",
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./flat": {
      "types": "./dist/flat/index.d.ts",
      "default": "./dist/flat/index.js"
    },
    "./flat/*": {
      "types": "./dist/flat/icons/*.d.ts",
      "default": "./dist/flat/icons/*.js"
    },
    "./high-contrast": {
      "types": "./dist/high-contrast/index.d.ts",
      "default": "./dist/high-contrast/index.js"
    },
    "./high-contrast/*": {
      "types": "./dist/high-contrast/icons/*.d.ts",
      "default": "./dist/high-contrast/icons/*.js"
    },
    "./modern": {
      "types": "./dist/modern/index.d.ts",
      "default": "./dist/modern/index.js"
    },
    "./modern/*": {
      "types": "./dist/modern/icons/*.d.ts",
      "default": "./dist/modern/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist && tsx build.ts",
    "test": "tsx test/smoke.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
